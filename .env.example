# PostgreSQL DBaaS: confirme a porta no painel (5432 abaixo é o padrão).
# Substitua SENHA_CODIFICADA pela senha codificada para URL. Não versione a senha.
DATABASE_URL=postgresql://alphacognus:SENHA_CODIFICADA@alphacognus.postgresql.dbaas.com.br:5432/alphacognus?sslmode=require
# Acesso externo, TLS e permissão de CREATE SCHEMA/TABLE devem estar liberados.
# Token aleatório de pelo menos 32 caracteres, apenas no servidor consumidor.
API_TOKEN=
PORT=3000
